<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- What Electron needs under the hardened runtime: V8 compiles to
         executable memory. No library-validation exemption: the app loads
         no native modules, only the frameworks signed with it. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- The webcam, for scanning QR codes. -->
    <key>com.apple.security.device.camera</key>
    <true/>
  </dict>
</plist>
